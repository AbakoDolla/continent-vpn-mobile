# ==============================================================================
# CONTINENT VPN - ENVIRONMENT VARIABLES TEMPLATE
# DO NOT COMMIT REAL CREDENTIALS OR KEYS TO SOURCE CONTROL
# ==============================================================================

# Application Environment
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0

# API Backend Gateway URL
EXPO_PUBLIC_API_URL=https://api.continentvpn.com/v1

# VPN Core Orchestrator Endpoint
EXPO_PUBLIC_VPN_COORDINATOR_URL=https://core.continentvpn.com

# Analytics & Telemetry (Optional)
EXPO_PUBLIC_ENABLE_ANALYTICS=false

# Support & Contact
EXPO_PUBLIC_SUPPORT_EMAIL=support@continentvpn.com
EXPO_PUBLIC_STATUS_PAGE_URL=https://status.continentvpn.com
